{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "topbins-preview",
  "account_id": "af3e2f28ee93e01e9ad59565728fd47d",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "topbins-staging-db",
      "database_id": "97ca691a-1ffc-440d-994a-04ea078c800b",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "previews": {
    "vars": {
      "PUBLISH_TOKEN": ""
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "topbins-staging-db",
        "database_id": "97ca691a-1ffc-440d-994a-04ea078c800b",
        "migrations_dir": "migrations",
        "remote": false
      }
    ],
    "r2_buckets": [
      {
        "binding": "MEDIA",
        "bucket_name": "topbins-staging-media",
        "remote": false
      }
    ],
    "images": {
      "binding": "IMAGES",
      "remote": false
    }
  }
}
