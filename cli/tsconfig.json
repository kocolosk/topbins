{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "*.ts",
    "../scripts/*.ts",
    "../test/cli.test.ts",
    "../test/preview.test.ts",
    "../test/video.test.ts",
    "../vitest.config.ts"
  ]
}
